# Settings → Database → Connection string (URI) — usado em T03 para `supabase db push`
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase — copie para .env e preencha com valores do dashboard
# Dashboard → Settings → API: https://supabase.com/dashboard/project/_/settings/api
#
# ATENÇÃO: SUPABASE_SERVICE_ROLE_KEY bypassa RLS — usar APENAS no servidor (FastAPI).

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Settings → API → JWT Settings → JWT Secret (usado em T11 para validar tokens)
SUPABASE_JWT_SECRET=your-jwt-secret

# Google Cloud — OAuth 2.0 (T02)
# Console: https://console.cloud.google.com/apis/credentials
# Cliente tipo "Web application" — usado pelo back-end para Calendar API (T16/T17)
#
# Escopos M1: openid email profile (login via Supabase) + calendar.readonly (sync agenda)
# Ver INTEGRATIONS.md § Setup (T02) para criar credenciais e habilitar Calendar API.

GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Redirect URI do OAuth Calendar (deve estar autorizado no Google Cloud Console)
# Local: http://localhost:8000/google/callback
# Produção: https://YOUR_APP.onrender.com/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback
