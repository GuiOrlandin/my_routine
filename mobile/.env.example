# Supabase — copie para .env.local e preencha com valores do dashboard
# Dashboard → Settings → API: https://supabase.com/dashboard/project/_/settings/api

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Cloud — OAuth 2.0 (T02)
# Web Client ID (mesmo do Supabase Auth + fluxo Calendar no Perfil)
# Console: https://console.cloud.google.com/apis/credentials
# Escopos: openid email profile (login) | calendar.readonly (conectar agenda — T31)
# Ver INTEGRATIONS.md § Setup (T02)

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
